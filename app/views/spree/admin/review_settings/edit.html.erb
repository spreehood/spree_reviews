<% content_for :page_title do %>
  <%= Spree.t(:review_settings, scope: :spree_reviews) %>
<% end %>

<%= form_tag admin_review_settings_path, method: :put do %>
  <div class="row">
    <div class="col-12 col-md-6" data-hook="reviews">
      <div class="custom-control custom-checkbox mb-3">
        <%= check_box_tag :include_unapproved_reviews, '1', SpreeReviews::Config[:include_unapproved_reviews], class: "custom-control-input" %>
        <%= label_tag :include_unapproved_reviews, Spree.t(:include_unapproved, scope: :spree_reviews), class: "custom-control-label" %>
      </div>

      <div class="custom-control custom-checkbox mb-3">
        <%= check_box_tag :feedback_rating, '1', SpreeReviews::Config[:feedback_rating], class: "custom-control-input" %>
        <%= label_tag :feedback_rating, Spree.t(:feedback_rating, scope: :spree_reviews), class: "custom-control-label" %>
      </div>

      <div class="custom-control custom-checkbox mb-3">
        <%= check_box_tag :show_email, '1', SpreeReviews::Config[:show_email], class: "custom-control-input" %>
        <%= label_tag :show_email, Spree.t(:show_email, scope: :spree_reviews), class: "custom-control-label" %>
      </div>

      <div class="custom-control custom-checkbox mb-3">
        <%= check_box_tag :require_login, '1', SpreeReviews::Config[:require_login], class: "custom-control-input" %>
        <%= label_tag :require_login, Spree.t(:require_login, scope: :spree_reviews), class: "custom-control-label" %>
      </div>

      <div class="custom-control custom-checkbox mb-3">
        <%= check_box_tag :track_locale, '1', SpreeReviews::Config[:track_locale], class: "custom-control-input" %>
        <%= label_tag :track_locale, Spree.t(:track_locale, scope: :spree_reviews), class: "custom-control-label" %>
      </div>

      <div class="custom-control custom-checkbox mb-3">
        <%= check_box_tag :show_identifier, '1', SpreeReviews::Config[:show_identifier], class: "custom-control-input" %>
        <%= label_tag :show_identifier, Spree.t(:show_identifier, scope: :spree_reviews), class: "custom-control-label" %>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="form-group">
        <%= label_tag Spree.t(:preview_size, scope: :spree_reviews) %>
        <%= number_field_tag :preview_size, SpreeReviews::Config[:preview_size], class: 'form-control w-auto' %>
      </div>

      <div class="form-group">
        <%= label_tag Spree.t(:paginate_size, scope: :spree_reviews) %>
        <%= number_field_tag :paginate_size, SpreeReviews::Config[:paginate_size], class: 'form-control w-auto' %>
      </div>
    </div>
    
    <div class="col">
      <div class="form-actions" data-hook="buttons">
        <%= button Spree.t('actions.update'), 'save.svg', 'submit', {class: 'btn btn-success', data: { disable_with: "#{ Spree.t(:saving) }..." }} %>
        <span class="or"><%= Spree.t(:or) %></span>
        <%= button_link_to Spree.t('actions.cancel'), admin_dashboard_url, icon: 'cancel.svg' %>
      </div>
    </div>
  </div>
<% end %>
